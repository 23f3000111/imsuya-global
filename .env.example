# Copy to .env.local for local development, and add the same names in
# Vercel -> Project -> Settings -> Environment Variables for the live site.
#
# Nothing here is needed for the site to run. The website assistant answers
# questions on its own, in the visitor's browser, with no API. These two
# settings only let it (and the contact page form) email each new brief to
# the studio's inbox. Without them, visitors are handed WhatsApp and email
# buttons with their brief already filled in.

# --- Enquiry email (the Hostinger mailbox) -----------------------------------
# Briefs are sent from this mailbox to itself. SMTP_PASS is that mailbox's own
# password (not the Hostinger account login). To set a new one: hPanel ->
# Emails -> imsuyaglobal.com -> Mailboxes (or Email Accounts) -> the three
# dots beside info@ -> change password. Changing it means updating any phone
# or Outlook mail app that uses the old one.
SMTP_USER=info@imsuyaglobal.com
SMTP_PASS=

# Optional, defaults shown.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# MAIL_TO=info@imsuyaglobal.com
